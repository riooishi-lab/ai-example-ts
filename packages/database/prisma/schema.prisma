generator client {
  provider        = "prisma-client"
  previewFeatures = ["views"]
  output          = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// User Management
// ============================================

model User {
  id         Int     @id @default(autoincrement()) @map("id")
  publicId   String  @unique @default(cuid()) @map("public_id")
  externalId String? @map("external_id")

  authProviderId String @unique @map("auth_provider_id")

  email       String  @unique @map("email")
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  phoneNumber String? @map("phone_number")

  role     UserRole @default(FIELD_WORKER) @map("role")
  lineName String?  @map("line_name")

  isActive        Boolean @default(true) @map("is_active")
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  lastSignedInAt DateTime? @map("last_signed_in_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncedAt  DateTime? @map("synced_at") @db.Timestamptz(6)

  invitationsSent           Invitation[]       @relation("InvitedBy")
  inspectionRecords         InspectionRecord[] @relation("Inspector")
  failureReportsAsReporter  FailureReport[]    @relation("Reporter")
  failureReportsAsResponder FailureReport[]    @relation("Responder")
  photos                    Photo[]            @relation("Uploader")

  @@index([publicId])
  @@index([externalId])
  @@index([email])
  @@index([authProviderId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  SYSTEM_ADMIN
  MANAGER
  MAINTENANCE
  FIELD_WORKER
}

// ============================================
// Invitation
// ============================================

model Invitation {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")
  token    String @unique @map("token")

  email       String  @map("email")
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  displayName String? @map("display_name")

  role UserRole @default(FIELD_WORKER) @map("role")

  status InvitationStatus @default(PENDING) @map("status")

  invitedById Int  @map("invited_by_id")
  invitedBy   User @relation("InvitedBy", fields: [invitedById], references: [id])

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([token])
  @@index([email])
  @@index([status])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================
// Equipment (設備マスタ)
// ============================================

model Equipment {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  name          String    @map("name")
  lineName      String    @map("line_name")
  machineNumber String    @map("machine_number")
  category      String?   @map("category")
  installedAt   DateTime? @map("installed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  parts             Part[]
  inspectionItems   InspectionItem[]
  inspectionRecords InspectionRecord[]
  failureReports    FailureReport[]

  @@index([publicId])
  @@index([lineName])
  @@index([deletedAt])
  @@map("equipments")
}

// ============================================
// Part (部品マスタ)
// ============================================

model Part {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  equipmentId Int       @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  name                     String    @map("name")
  standardReplaceCycleDays Int?      @map("standard_replace_cycle_days")
  lastReplacedAt           DateTime? @map("last_replaced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  failureReports FailureReport[]

  @@index([equipmentId])
  @@index([publicId])
  @@index([deletedAt])
  @@map("parts")
}

// ============================================
// Inspection Item (点検項目マスタ)
// ============================================

model InspectionItem {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  equipmentId Int       @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  name       String              @map("name")
  inputType  InspectionInputType @map("input_type")
  unit       String?             @map("unit")
  upperLimit Float?              @map("upper_limit")
  lowerLimit Float?              @map("lower_limit")
  sortOrder  Int                 @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  inspectionValues InspectionValue[]

  @@index([equipmentId])
  @@index([publicId])
  @@index([deletedAt])
  @@map("inspection_items")
}

enum InspectionInputType {
  NUMERIC
  TEXT
}

// ============================================
// Inspection Record (点検記録)
// ============================================

model InspectionRecord {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  equipmentId Int       @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  inspectorId Int  @map("inspector_id")
  inspector   User @relation("Inspector", fields: [inspectorId], references: [id])

  inspectedAt DateTime         @map("inspected_at") @db.Timestamptz(6)
  status      InspectionStatus @default(IN_PROGRESS) @map("status")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  values InspectionValue[]

  @@index([equipmentId])
  @@index([inspectorId])
  @@index([inspectedAt])
  @@index([publicId])
  @@index([deletedAt])
  @@map("inspection_records")
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

// ============================================
// Inspection Value (点検値)
// ============================================

model InspectionValue {
  id Int @id @default(autoincrement()) @map("id")

  recordId Int              @map("record_id")
  record   InspectionRecord @relation(fields: [recordId], references: [id])

  itemId Int            @map("item_id")
  item   InspectionItem @relation(fields: [itemId], references: [id])

  numericValue Float?  @map("numeric_value")
  textValue    String? @map("text_value")
  isAbnormal   Boolean @default(false) @map("is_abnormal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([recordId, itemId])
  @@index([recordId])
  @@index([itemId])
  @@map("inspection_values")
}

// ============================================
// Failure Report (不具合報告)
// ============================================

model FailureReport {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  equipmentId Int       @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  partId Int?  @map("part_id")
  part   Part? @relation(fields: [partId], references: [id])

  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  symptom        String   @map("symptom")
  estimatedCause String?  @map("estimated_cause")
  action         String   @map("action")
  actionAt       DateTime @map("action_at") @db.Timestamptz(6)

  reporterId Int  @map("reporter_id")
  reporter   User @relation("Reporter", fields: [reporterId], references: [id])

  responderId Int  @map("responder_id")
  responder   User @relation("Responder", fields: [responderId], references: [id])

  note String? @map("note")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  photos Photo[]

  @@index([equipmentId])
  @@index([partId])
  @@index([reporterId])
  @@index([responderId])
  @@index([occurredAt])
  @@index([publicId])
  @@index([deletedAt])
  @@map("failure_reports")
}

// ============================================
// Photo (添付写真)
// ============================================

model Photo {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  failureReportId Int           @map("failure_report_id")
  failureReport   FailureReport @relation(fields: [failureReportId], references: [id])

  filePath   String    @map("file_path")
  capturedAt DateTime? @map("captured_at") @db.Timestamptz(6)

  uploaderId Int  @map("uploader_id")
  uploader   User @relation("Uploader", fields: [uploaderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([failureReportId])
  @@index([uploaderId])
  @@map("photos")
}

// ============================================
// AI Report (AIレポート)
// ============================================

model AiReport {
  id       Int    @id @default(autoincrement()) @map("id")
  publicId String @unique @default(cuid()) @map("public_id")

  targetYear  Int  @map("target_year")
  targetMonth Int  @map("target_month")
  reportData  Json @map("report_data")
  pdfPath     String? @map("pdf_path")

  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([targetYear, targetMonth])
  @@index([targetYear, targetMonth])
  @@map("ai_reports")
}

// ============================================
// Database Views
// ============================================

view VisibleUser {
  id              Int       @unique
  publicId        String    @unique @map("public_id")
  externalId      String?   @map("external_id")
  authProviderId  String    @unique @map("auth_provider_id")
  email           String    @unique
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  phoneNumber     String?   @map("phone_number")
  role            UserRole
  lineName        String?   @map("line_name")
  isActive        Boolean   @map("is_active")
  isEmailVerified Boolean   @map("is_email_verified")
  lastSignedInAt  DateTime? @map("last_signed_in_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncedAt        DateTime? @map("synced_at") @db.Timestamptz(6)

  @@map("visible_users")
}

view VisibleInvitation {
  id          Int              @unique
  publicId    String           @unique @map("public_id")
  token       String           @unique
  email       String
  firstName   String           @map("first_name")
  lastName    String           @map("last_name")
  displayName String?          @map("display_name")
  role        UserRole
  status      InvitationStatus
  invitedById Int              @map("invited_by_id")
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @map("updated_at") @db.Timestamptz(6)
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@map("visible_invitations")
}

view VisibleEquipment {
  id            Int       @unique
  publicId      String    @unique @map("public_id")
  name          String
  lineName      String    @map("line_name")
  machineNumber String    @map("machine_number")
  category      String?
  installedAt   DateTime? @map("installed_at") @db.Timestamptz(6)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("visible_equipments")
}

view VisiblePart {
  id                       Int       @unique
  publicId                 String    @unique @map("public_id")
  equipmentId              Int       @map("equipment_id")
  name                     String
  standardReplaceCycleDays Int?      @map("standard_replace_cycle_days")
  lastReplacedAt           DateTime? @map("last_replaced_at") @db.Timestamptz(6)
  createdAt                DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("visible_parts")
}

view VisibleInspectionItem {
  id          Int                 @unique
  publicId    String              @unique @map("public_id")
  equipmentId Int                 @map("equipment_id")
  name        String
  inputType   InspectionInputType @map("input_type")
  unit        String?
  upperLimit  Float?              @map("upper_limit")
  lowerLimit  Float?              @map("lower_limit")
  sortOrder   Int                 @map("sort_order")
  createdAt   DateTime            @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@map("visible_inspection_items")
}

view VisibleInspectionRecord {
  id          Int              @unique
  publicId    String           @unique @map("public_id")
  equipmentId Int              @map("equipment_id")
  inspectorId Int              @map("inspector_id")
  inspectedAt DateTime         @map("inspected_at") @db.Timestamptz(6)
  status      InspectionStatus
  createdAt   DateTime         @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@map("visible_inspection_records")
}

view VisibleFailureReport {
  id             Int       @unique
  publicId       String    @unique @map("public_id")
  equipmentId    Int       @map("equipment_id")
  partId         Int?      @map("part_id")
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(6)
  symptom        String
  estimatedCause String?   @map("estimated_cause")
  action         String
  actionAt       DateTime  @map("action_at") @db.Timestamptz(6)
  reporterId     Int       @map("reporter_id")
  responderId    Int       @map("responder_id")
  note           String?
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("visible_failure_reports")
}
